 <!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Онлайн-бібліотека{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_book_index') }}">📚 BookLibrary</a>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_book_index') }}">Каталог</a>
            <a class="btn btn-outline-info btn-sm" href="/api/books" target="_blank">JSON API</a>
            <a class="btn btn-warning btn-sm fw-semibold" href="/admin">Адмінка</a>
        </div>
    </div>
</nav>

<main class="container flex-grow-1 pb-5">
    {% block body %}{% endblock %}
</main>

<footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
    <div class="container">BookLibrary — Symfony + Doctrine + Twig + EasyAdmin</div>
</footer>

</body>
</html>